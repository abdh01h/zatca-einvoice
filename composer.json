{
    "name": "abdh01h/zatca-einvoice",
    "description": "ZATCA (Fatoora) e-invoicing for PHP: UBL 2.1 generation, Phase-1/Phase-2 QR codes, invoice hashing, XAdES cryptography and business-rule validation.",
    "type": "library",
    "license": "MIT",
    "keywords": ["zatca", "fatoora", "einvoicing", "e-invoicing", "saudi", "vat", "ubl", "xades", "sar"],
    "authors": [
        {
            "name": "Abdullah Aldarkhbani",
            "homepage": "https://abdh01.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-dom": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5 || ^12.0",
        "phpstan/phpstan": "^2.1"
    },
    "suggest": {
        "illuminate/support": "Required only for the optional Laravel service provider (^10 || ^11 || ^12)",
        "ext-bcmath": "Not required: all money arithmetic is integer-based"
    },
    "autoload": {
        "psr-4": {
            "Zatca\\EInvoice\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zatca\\EInvoice\\Tests\\": "tests/"
        }
    },
    "bin": ["bin/zatca"],
    "config": {
        "sort-packages": true,
        "allow-plugins": false
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "analyse": "phpstan analyse --no-progress",
        "check": ["@analyse", "@test"]
    }
}
